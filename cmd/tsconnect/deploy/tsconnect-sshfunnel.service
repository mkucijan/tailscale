[Unit]
Description=tsnet node (ssh-arch) exposing themed tsconnect via Funnel
After=network-online.target tsconnect-themed.service
Wants=tsconnect-themed.service
[Service]
Environment=SSHFUNNEL_HOSTNAME=ssh-arch
ExecStart=%h/dev/tsconnect-themed/sshfunnel -hostname ${SSHFUNNEL_HOSTNAME} -backend http://127.0.0.1:9091
Restart=on-failure
RestartSec=10
[Install]
WantedBy=default.target
